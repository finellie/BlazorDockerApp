# ============================================================
#  Переменные окружения для деплоя через Dockhand
#  Скопируйте этот файл в .env и заполните значения.
# ============================================================

# --- Образ приложения ---------------------------------------
# Публикуется workflow .github/workflows/docker-publish.yml
# Формат: ghcr.io/<owner>/<repo>:<tag>
# Тег latest обновляется при каждом push в main.
APP_IMAGE=ghcr.io/finellie/blazordockerapp:latest

# --- PostgreSQL ---------------------------------------------
POSTGRES_DB=blazordockerapp
POSTGRES_USER=blazorapp

# ВАЖНО: замените на надёжный пароль перед деплоем.
# Сгенерировать: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Веб-приложение -----------------------------------------
# Порт на хосте, по которому будет доступно приложение.
# Убедитесь, что он свободен и открыт в firewall (ufw).
WEB_PORT=9115
